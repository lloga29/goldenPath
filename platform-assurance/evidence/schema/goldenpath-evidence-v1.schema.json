{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenpath.dev/schemas/evidence/goldenpath-evidence-v1.schema.json",
  "title": "GoldenPath Evidence Manifest v1",
  "description": "Versioned evidence contract for deriving GoldenPath readiness claims from commit-bound, auditable evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "generatedAt",
    "claimLevel",
    "decision",
    "source",
    "context",
    "inputs",
    "gates"
  ],
  "properties": {
    "schemaVersion": {
      "const": "goldenpath.evidence/v1"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "claimLevel": {
      "type": "string",
      "enum": [
        "implemented",
        "reference",
        "runtime-validated",
        "production-validated"
      ]
    },
    "decision": {
      "type": "string",
      "enum": ["READY", "NOT_READY"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commitSha"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "commitSha": {
          "$ref": "#/$defs/gitSha"
        },
        "workflowName": {
          "type": "string",
          "minLength": 1
        },
        "workflowRunUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "capability"],
      "properties": {
        "environment": {
          "type": "string",
          "enum": ["repository", "dev", "staging", "prod", "ephemeral"]
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "service": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "identity"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["container", "package", "bundle", "none"]
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSha",
        "policyDigest",
        "architectureDigest",
        "desiredStateDigest"
      ],
      "properties": {
        "sourceSha": {
          "$ref": "#/$defs/gitSha"
        },
        "policyDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "architectureDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "desiredStateDigest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/gateEvidence"
      }
    },
    "runtimeEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/runtimeEvidence"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "claimLevel": {
            "enum": ["runtime-validated", "production-validated"]
          }
        },
        "required": ["claimLevel"]
      },
      "then": {
        "required": ["runtimeEvidence"]
      }
    },
    {
      "if": {
        "properties": {
          "claimLevel": {
            "const": "production-validated"
          }
        },
        "required": ["claimLevel"]
      },
      "then": {
        "properties": {
          "context": {
            "properties": {
              "environment": {
                "const": "prod"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "required",
        "skipAllowed",
        "result",
        "observedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
        },
        "required": {
          "type": "boolean"
        },
        "skipAllowed": {
          "type": "boolean"
        },
        "result": {
          "type": "string",
          "enum": ["PASS", "FAIL", "INFRASTRUCTURE_FAILURE", "SKIP_ALLOWED"]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "evidenceUrl": {
          "type": "string",
          "format": "uri"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtimeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "result", "observedAt", "evidenceUrl"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["deployment", "health", "rollout", "smoke", "slo", "rollback"]
        },
        "result": {
          "type": "string",
          "enum": ["PASS", "FAIL", "INFRASTRUCTURE_FAILURE"]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "evidenceUrl": {
          "type": "string",
          "format": "uri"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
