name: CI

on:
  pull_request:
    branches: [main]
  push:
    branches: [main]

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

env:
  IMAGE_NAME: ghcr.io/{{ github_owner }}/{{ project_name }}

jobs:
  quality:
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v7

      - name: Setup Go
        uses: actions/setup-go@v7
        with:
          go-version-file: go.mod
          cache: true

      - name: Verify modules
        run: |
          go mod tidy
          git diff --exit-code -- go.mod go.sum
          go mod verify

      - name: Check formatting
        run: |
          files="$(gofmt -l .)"
          if [[ -n "$files" ]]; then
            echo "The following files require gofmt:"
            echo "$files"
            exit 1
          fi

      - name: Vet
        run: go vet ./...

      - name: Lint
        uses: golangci/golangci-lint-action@v9
        with:
          version: v2.12.0

      - name: Test
        run: go test -race -coverprofile=coverage.out ./...

  security:
    needs: quality
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v7

      - name: Scan source and dependencies with Trivy
        uses: aquasecurity/trivy-action@0.36.0
        with:
          scan-type: fs
          format: table
          exit-code: '1'
          ignore-unfixed: true
          severity: HIGH,CRITICAL

  container-build:
    if: {% raw %}${{ github.event_name == 'pull_request' }}{% endraw %}
    needs: [quality, security]
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v7

      - name: Setup Docker Buildx
        uses: docker/setup-buildx-action@v4

      - name: Build container without publishing
        uses: docker/build-push-action@v6
        with:
          context: .
          push: false
          build-args: |
            VERSION={% raw %}${{ github.sha }}{% endraw %}
            GIT_COMMIT={% raw %}${{ github.sha }}{% endraw %}
            IMAGE_SOURCE=https://github.com/{{ github_owner }}/{{ project_name }}
            SERVICE_PORT={{ port }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

  publish:
    if: {% raw %}${{ github.event_name == 'push' && github.ref == 'refs/heads/main' }}{% endraw %}
    needs: [quality, security]
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
      id-token: write
    steps:
      - uses: actions/checkout@v7

      - name: Setup Docker Buildx
        uses: docker/setup-buildx-action@v4

      - name: Authenticate to GHCR
        uses: docker/login-action@v4
        with:
          registry: ghcr.io
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

      - name: Build and publish immutable image
        id: build
        uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          tags: {% raw %}${{ env.IMAGE_NAME }}:${{ github.sha }}{% endraw %}
          build-args: |
            VERSION={% raw %}${{ github.sha }}{% endraw %}
            GIT_COMMIT={% raw %}${{ github.sha }}{% endraw %}
            IMAGE_SOURCE=https://github.com/{{ github_owner }}/{{ project_name }}
            SERVICE_PORT={{ port }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
          sbom: true
          provenance: mode=max

      - name: Verify published SPDX SBOM by immutable digest
        env:
          DIGEST: {% raw %}${{ steps.build.outputs.digest }}{% endraw %}
          SBOM_PATH: {% raw %}${{ runner.temp }}{% endraw %}/sbom.spdx.json
        run: |
          if [[ ! "$DIGEST" =~ ^sha256:[0-9a-f]{64}$ ]]; then
            echo "ERROR: build output digest is missing or malformed: $DIGEST" >&2
            exit 1
          fi

          IMAGE_REF="${IMAGE_NAME}@${DIGEST}"
          docker buildx imagetools inspect "$IMAGE_REF" \
            --format '{% raw %}{{ json .SBOM.SPDX }}{% endraw %}' > "$SBOM_PATH"

          python3 - <<'PY'
          import json
          import os
          import sys
          from pathlib import Path

          path = Path(os.environ["SBOM_PATH"])
          try:
              document = json.loads(path.read_text(encoding="utf-8"))
          except (OSError, json.JSONDecodeError) as exc:
              print(f"ERROR: cannot read a valid SPDX SBOM from {path}: {exc}", file=sys.stderr)
              raise SystemExit(1)

          if not isinstance(document, dict):
              print("ERROR: published SBOM payload is not a JSON object", file=sys.stderr)
              raise SystemExit(1)
          if document.get("SPDXID") != "SPDXRef-DOCUMENT":
              print("ERROR: published SBOM is missing SPDXRef-DOCUMENT identity", file=sys.stderr)
              raise SystemExit(1)
          version = document.get("spdxVersion")
          if not isinstance(version, str) or not version.startswith("SPDX-"):
              print("ERROR: published SBOM has an invalid spdxVersion", file=sys.stderr)
              raise SystemExit(1)
          creation_info = document.get("creationInfo")
          if not isinstance(creation_info, dict) or not creation_info.get("created"):
              print("ERROR: published SBOM is missing SPDX creation metadata", file=sys.stderr)
              raise SystemExit(1)
          packages = document.get("packages")
          if not isinstance(packages, list) or not packages:
              print("ERROR: published SBOM contains no package inventory", file=sys.stderr)
              raise SystemExit(1)

          print(f"PASS: verified {version} SBOM with {len(packages)} package entries")
          PY

          echo "Verified registry-attached SPDX SBOM for ${IMAGE_REF}" >> "$GITHUB_STEP_SUMMARY"

      - name: Verify published SLSA provenance by immutable digest
        env:
          DIGEST: {% raw %}${{ steps.build.outputs.digest }}{% endraw %}
          PROVENANCE_PATH: {% raw %}${{ runner.temp }}{% endraw %}/provenance.slsa.json
        run: |
          if [[ ! "$DIGEST" =~ ^sha256:[0-9a-f]{64}$ ]]; then
            echo "ERROR: build output digest is missing or malformed: $DIGEST" >&2
            exit 1
          fi

          IMAGE_REF="${IMAGE_NAME}@${DIGEST}"
          docker buildx imagetools inspect "$IMAGE_REF" \
            --format '{% raw %}{{ json .Provenance.SLSA }}{% endraw %}' > "$PROVENANCE_PATH"

          python3 - <<'PY'
          import json
          import os
          import sys
          from pathlib import Path

          path = Path(os.environ["PROVENANCE_PATH"])
          try:
              document = json.loads(path.read_text(encoding="utf-8"))
          except (OSError, json.JSONDecodeError) as exc:
              print(f"ERROR: cannot read valid SLSA provenance from {path}: {exc}", file=sys.stderr)
              raise SystemExit(1)

          if not isinstance(document, dict):
              print("ERROR: published provenance payload is not a JSON object", file=sys.stderr)
              raise SystemExit(1)
          if document.get("buildType") != "https://mobyproject.org/buildkit@v1":
              print("ERROR: published provenance has an unexpected BuildKit buildType", file=sys.stderr)
              raise SystemExit(1)
          if not isinstance(document.get("builder"), dict):
              print("ERROR: published provenance is missing builder metadata", file=sys.stderr)
              raise SystemExit(1)
          if not isinstance(document.get("invocation"), dict):
              print("ERROR: published provenance is missing invocation metadata", file=sys.stderr)
              raise SystemExit(1)
          materials = document.get("materials")
          if not isinstance(materials, list) or not materials:
              print("ERROR: published provenance contains no build materials", file=sys.stderr)
              raise SystemExit(1)
          metadata = document.get("metadata")
          if not isinstance(metadata, dict):
              print("ERROR: published provenance is missing build metadata", file=sys.stderr)
              raise SystemExit(1)
          for field in ("buildStartedOn", "buildFinishedOn"):
              if not isinstance(metadata.get(field), str) or not metadata[field]:
                  print(f"ERROR: published provenance is missing metadata.{field}", file=sys.stderr)
                  raise SystemExit(1)

          print(f"PASS: verified BuildKit SLSA provenance with {len(materials)} material entries")
          PY

          echo "Verified registry-attached SLSA provenance for ${IMAGE_REF}" >> "$GITHUB_STEP_SUMMARY"

      - name: Install Cosign
        uses: sigstore/cosign-installer@v4.1.2

      - name: Sign and verify published image with GitHub OIDC
        env:
          DIGEST: {% raw %}${{ steps.build.outputs.digest }}{% endraw %}
        run: |
          IMAGE_REF="${IMAGE_NAME}@${DIGEST}"
          CERTIFICATE_IDENTITY="https://github.com/{{ github_owner }}/{{ project_name }}/.github/workflows/ci.yaml@refs/heads/main"

          cosign sign --yes "$IMAGE_REF"
          cosign verify "$IMAGE_REF" \
            --certificate-identity="$CERTIFICATE_IDENTITY" \
            --certificate-oidc-issuer="https://token.actions.githubusercontent.com" >/dev/null

          echo "Verified keyless Cosign signature for ${IMAGE_REF} from ${CERTIFICATE_IDENTITY}" >> "$GITHUB_STEP_SUMMARY"
