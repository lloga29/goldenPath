package handlers

import (
	"net/http"
	"net/http/httptest"
	"testing"
)

func TestHealth(t *testing.T) {
	checker := NewHealthChecker()
	request := httptest.NewRequest(http.MethodGet, "/health", nil)
	response := httptest.NewRecorder()

	checker.Health("v1.2.3").ServeHTTP(response, request)
	if response.Code != http.StatusOK {
		t.Fatalf("health status = %d, want %d", response.Code, http.StatusOK)
	}
}

func TestReadinessLifecycle(t *testing.T) {
	checker := NewHealthChecker()
	request := httptest.NewRequest(http.MethodGet, "/ready", nil)

	notReady := httptest.NewRecorder()
	checker.Ready().ServeHTTP(notReady, request)
	if notReady.Code != http.StatusServiceUnavailable {
		t.Fatalf("initial readiness status = %d, want %d", notReady.Code, http.StatusServiceUnavailable)
	}

	checker.SetReady(true)
	ready := httptest.NewRecorder()
	checker.Ready().ServeHTTP(ready, request)
	if ready.Code != http.StatusOK {
		t.Fatalf("ready status = %d, want %d", ready.Code, http.StatusOK)
	}
}
