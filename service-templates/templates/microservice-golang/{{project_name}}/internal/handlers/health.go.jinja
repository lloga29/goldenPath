// Package handlers contains reusable HTTP handlers for the service.
package handlers

import (
	"encoding/json"
	"net/http"
	"sync/atomic"
)

// HealthChecker manages liveness/readiness state.
type HealthChecker struct {
	ready atomic.Bool
}

// NewHealthChecker creates a checker that starts as not ready.
func NewHealthChecker() *HealthChecker {
	return &HealthChecker{}
}

// SetReady changes readiness state. Call it only after startup dependencies are usable.
func (hc *HealthChecker) SetReady(ready bool) {
	hc.ready.Store(ready)
}

// HealthResponse is the stable health endpoint response contract.
type HealthResponse struct {
	Status  string `json:"status"`
	Service string `json:"service"`
	Version string `json:"version,omitempty"`
}

// Health serves the liveness endpoint. It does not perform dependency checks.
func (hc *HealthChecker) Health(version string) http.HandlerFunc {
	return func(w http.ResponseWriter, _ *http.Request) {
		writeJSON(w, http.StatusOK, HealthResponse{
			Status:  "healthy",
			Service: "{{ project_name }}",
			Version: version,
		})
	}
}

// Ready serves the readiness endpoint and reflects the service's dependency readiness state.
func (hc *HealthChecker) Ready() http.HandlerFunc {
	return func(w http.ResponseWriter, _ *http.Request) {
		if !hc.ready.Load() {
			writeJSON(w, http.StatusServiceUnavailable, HealthResponse{
				Status:  "not_ready",
				Service: "{{ project_name }}",
			})
			return
		}

		writeJSON(w, http.StatusOK, HealthResponse{
			Status:  "ready",
			Service: "{{ project_name }}",
		})
	}
}

func writeJSON(w http.ResponseWriter, status int, payload HealthResponse) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	_ = json.NewEncoder(w).Encode(payload)
}
