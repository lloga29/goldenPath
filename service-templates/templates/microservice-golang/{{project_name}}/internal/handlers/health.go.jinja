// Package handlers contiene los handlers HTTP del servicio
package handlers

import (
	"encoding/json"
	"net/http"
	"sync/atomic"
)

// HealthChecker gestiona el estado de salud del servicio
type HealthChecker struct {
	ready atomic.Bool
}

// NewHealthChecker crea un nuevo HealthChecker
func NewHealthChecker() *HealthChecker {
	hc := &HealthChecker{}
	hc.ready.Store(false)
	return hc
}

// SetReady marca el servicio como listo
func (hc *HealthChecker) SetReady(ready bool) {
	hc.ready.Store(ready)
}

// HealthResponse estructura de respuesta de health
type HealthResponse struct {
	Status  string `json:"status"`
	Service string `json:"service"`
	Version string `json:"version,omitempty"`
}

// Health handler para /health (liveness probe)
func (hc *HealthChecker) Health(version string) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusOK)
		json.NewEncoder(w).Encode(HealthResponse{
			Status:  "healthy",
			Service: "{{ project_name }}",
			Version: version,
		})
	}
}

// Ready handler para /ready (readiness probe)
func (hc *HealthChecker) Ready() http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "application/json")

		if !hc.ready.Load() {
			w.WriteHeader(http.StatusServiceUnavailable)
			json.NewEncoder(w).Encode(HealthResponse{
				Status:  "not_ready",
				Service: "{{ project_name }}",
			})
			return
		}

		w.WriteHeader(http.StatusOK)
		json.NewEncoder(w).Encode(HealthResponse{
			Status:  "ready",
			Service: "{{ project_name }}",
		})
	}
}
