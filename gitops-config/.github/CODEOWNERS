# Reference CODEOWNERS for a standalone GitOps repository.
# Replace `@org/*` placeholders with real organization teams during adoption.

# Default ownership
*                               @org/platform-team

# Argo CD control-plane configuration
argocd/                         @org/platform-team

# Cluster-specific state
clusters/prod/                  @org/platform-team @org/sre-team
clusters/staging/               @org/platform-team
clusters/dev/                   @org/platform-team

# Shared platform components
platform/                       @org/platform-team

# Policy changes require security review
policies/                       @org/platform-team @org/security-team

# Team applications
apps/team-payments/             @org/team-payments @org/platform-team
apps/team-orders/               @org/team-orders @org/platform-team

# Production desired state requires platform and SRE ownership
apps/*/overlays/prod/           @org/platform-team @org/sre-team
