# Stack de Entorno: {{ client_name }} - {{ environment }}
# Infraestructura para el entorno {{ environment }}

terraform {
  required_version = ">= 1.5.0, < 2.0.0"

  backend "s3" {
    bucket         = "client-{{ client_name }}-terraform-state"
    key            = "platform/{{ stack_name }}/{{ environment }}/terraform.tfstate"
    region         = "{{ aws_region }}"
    encrypt        = true
    dynamodb_table = "client-{{ client_name }}-terraform-locks"
  }

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 5.0.0, < 6.0.0"
    }
  }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = local.common_tags
  }
}

# ============================================
# VARIABLES
# ============================================
variable "aws_region" {
  description = "Región de AWS"
  type        = string
  default     = "{{ aws_region }}"
}

variable "environment" {
  description = "Entorno"
  type        = string
  default     = "{{ environment }}"
}

variable "client" {
  description = "Nombre del cliente"
  type        = string
  default     = "{{ client_name }}"
}

# ============================================
# LOCALS
# ============================================
locals {
  common_tags = {
    Environment = var.environment
    Client      = var.client
    ManagedBy   = "terraform"
    Project     = "{{ stack_name }}"
  }
}

